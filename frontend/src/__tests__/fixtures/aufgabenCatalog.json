 {
  "id": "set_illumination",
  "title": "Set illumination",
  "category": "Illumination",
  "description": "",
  "kind": "task",
  "schema": {
   "additionalProperties": false,
   "properties": {
    "source": {
     "description": "Light source as named in the setup.",
     "title": "Source",
     "type": "string",
     "x-choices-from": "illumination",
     "enum": [
      "LED",
      "Laser488"
     ]
    },
    "intensity": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Value in the source's own range; empty keeps the current value.",
     "title": "Intensity"
    },
    "on": {
     "default": true,
     "description": "Switch the source on or off.",
     "title": "On",
     "type": "boolean"
    }
   },
   "required": [
    "source"
   ],
   "title": "set_illumination_params",
   "type": "object"
  },
  "locks": [],
  "effects": "REPEATABLE",
  "flags": {
   "moves_xy": false,
   "moves_z": false,
   "homes": false,
   "emits_light": true,
   "external": false,
   "runs_code": false,
   "needs": [
    "illumination"
   ],
   "ask_first": false
  }
 },
 {
  "id": "autofocus",
  "title": "Autofocus",
  "category": "Focus",
  "description": "Focuses at the current XY and returns the focused Z, or nothing if it failed.",
  "kind": "task",
  "schema": {
   "additionalProperties": false,
   "properties": {
    "mode": {
     "default": "software",
     "description": "software sweeps Z and scores images; hardware uses the focus lock.",
     "enum": [
      "software",
      "hardware"
     ],
     "title": "Mode",
     "type": "string"
    },
    "range_um": {
     "default": 50.0,
     "description": "Half range around the current Z (software mode).",
     "exclusiveMinimum": 0,
     "title": "Range Um",
     "type": "number",
     "x-unit": "\u00b5m"
    },
    "step_um": {
     "default": 5.0,
     "description": "Z step (software mode).",
     "exclusiveMinimum": 0,
     "title": "Step Um",
     "type": "number",
     "x-unit": "\u00b5m"
    },
    "channel": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Light switched on while focusing, and off afterwards; empty keeps the light as it is.",
     "title": "Channel",
     "x-choices-from": "illumination",
     "enum": [
      "LED",
      "Laser488"
     ]
    },
    "intensity": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Intensity of that light; empty keeps its current value.",
     "title": "Intensity"
    },
    "algorithm": {
     "default": "LAPE",
     "description": "Focus metric (software mode).",
     "enum": [
      "LAPE",
      "GLVA",
      "JPEG"
     ],
     "title": "Algorithm",
     "type": "string"
    },
    "settle_s": {
     "default": 0.1,
     "description": "Wait after each Z step.",
     "title": "Settle S",
     "type": "number",
     "x-unit": "s"
    },
    "max_attempts": {
     "default": 2,
     "description": "Attempts before giving up.",
     "exclusiveMinimum": 0,
     "title": "Max Attempts",
     "type": "integer"
    }
   },
   "title": "autofocus_params",
   "type": "object"
  },
  "locks": [
   "stage"
  ],
  "effects": "IRREVERSIBLE",
  "flags": {
   "moves_xy": false,
   "moves_z": true,
   "homes": false,
   "emits_light": true,
   "external": false,
   "runs_code": false,
   "needs": [
    "autofocus"
   ],
   "ask_first": false
  }
 }
]

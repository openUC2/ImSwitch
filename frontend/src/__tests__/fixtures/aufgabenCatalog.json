[
 {
  "id": "loop_positions",
  "title": "Loop over positions",
  "category": "Loops",
  "kind": "control",
  "description": "",
  "branches": [
   "body"
  ],
  "loop": true,
  "axis": "p",
  "ref_kinds": {
   "source": [
    "positions"
   ],
   "focus_map": [
    "focus_map"
   ]
  },
  "expr_fields": [],
  "schema": {
   "$defs": {
    "AbsolutePosition": {
     "title": "AbsolutePosition",
     "type": "object"
    },
    "FocusMapResource": {
     "title": "FocusMapResource",
     "type": "object"
    }
   },
   "additionalProperties": false,
   "properties": {
    "source": {
     "description": "Positions to visit, or '@name' of a positions resource",
     "items": {
      "$ref": "#/$defs/AbsolutePosition"
     },
     "title": "Source",
     "type": "array"
    },
    "move": {
     "default": true,
     "description": "Move to each position (XY and its Z, if set)",
     "title": "Move",
     "type": "boolean"
    },
    "focus_map": {
     "anyOf": [
      {
       "$ref": "#/$defs/FocusMapResource"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "'@name' of a focus_map resource: Z follows its surface at every item"
    },
    "split_storage": {
     "default": false,
     "description": "One output per position",
     "title": "Split Storage",
     "type": "boolean"
    }
   },
   "required": [
    "source"
   ],
   "title": "LoopPositionsParams",
   "type": "object"
  }
 },

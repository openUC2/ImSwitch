 {
  "id": "time_lapse",
  "title": "Time lapse",
  "category": "Loops",
  "kind": "control",
  "description": "",
  "branches": [
   "body",
   "idle"
  ],
  "loop": true,
  "axis": "t",
  "ref_kinds": {
   "plan": [
    "time_plan"
   ]
  },
  "expr_fields": [
   "until"
  ],
  "schema": {
   "$defs": {
    "MultiPhaseTimePlan": {
     "title": "MultiPhaseTimePlan",
     "type": "object"
    },
    "TDurationLoops": {
     "title": "TDurationLoops",
     "type": "object"
    },
    "TIntervalDuration": {
     "title": "TIntervalDuration",
     "type": "object"
    },
    "TIntervalLoops": {
     "title": "TIntervalLoops",
     "type": "object"
    }
   },
   "additionalProperties": false,
   "properties": {
    "plan": {
     "anyOf": [
      {
       "$ref": "#/$defs/MultiPhaseTimePlan"
      },
      {
       "$ref": "#/$defs/TIntervalDuration"
      },
      {
       "$ref": "#/$defs/TIntervalLoops"
      },
      {
       "$ref": "#/$defs/TDurationLoops"
      }
     ],
     "description": "Interval and count or duration",
     "title": "Plan"
    },
    "on_overrun": {
     "default": "run_now",
     "description": "When a round ends after the next start time: start the next round at once, or skip the missed start times",
     "enum": [
      "run_now",
      "skip"
     ],
     "title": "On Overrun",
     "type": "string"
    },
    "until": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Stop early when this expression is true",
     "title": "Until"
    },
    "split_storage": {
     "default": false,
     "title": "Split Storage",
     "type": "boolean"
    }
   },
   "required": [
    "plan"
   ],
   "title": "TimeLapseParams",
   "type": "object"
  }

 {
  "id": "move_relative",
  "title": "Move by",
  "category": "Stage",
  "description": "Moves by the given distances and waits until the stage arrives.",
  "kind": "task",
  "schema": {
   "additionalProperties": false,
   "properties": {
    "dx_um": {
     "default": 0.0,
     "description": "Distance in X.",
     "title": "Dx Um",
     "type": "number",
     "x-unit": "\u00b5m"
    },
    "dy_um": {
     "default": 0.0,
     "description": "Distance in Y.",
     "title": "Dy Um",
     "type": "number",
     "x-unit": "\u00b5m"
    },
    "dz_um": {
     "default": 0.0,
     "description": "Distance in Z. Positive Z direction depends on the stand.",
     "title": "Dz Um",
     "type": "number",
     "x-unit": "\u00b5m"
    },
    "speed_um_s": {
     "anyOf": [
      {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Speed; empty uses the stage default.",
     "title": "Speed Um S",
     "x-unit": "\u00b5m/s"
    }
   },
   "title": "move_relative_params",
   "type": "object"
  },
  "locks": [
   "stage"
  ],
  "effects": "IRREVERSIBLE",
  "flags": {
   "moves_xy": true,
   "moves_z": true,
   "homes": false,
   "emits_light": false,
   "external": false,
   "runs_code": false,
   "needs": [
    "stage"
   ],
   "ask_first": false
  }
 },
